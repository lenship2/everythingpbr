patch
{
	include					"materials/dev/l2_default_pbr_4x4.vmt"
	insert
	{
		$basetexture 			"pbr/metal/black_floor_01_color"
		$bumpmap 				"pbr/metal/black_floor_01_normal"
		$mraotexture			"pbr/metal/black_floor_01_mrao"

		$hsv					"[1 1 0.95]"
		$reflectivity			"[0.6 0.6 0.6]"
		
		$surfaceprop			"metalpanel"
	}
	replace
	{
		$envmaptint				"0.1"
	}
}