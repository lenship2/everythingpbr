patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/metal/metal_treadplate_brown_color"
		$bumpmap 				"pbr/metal/metal_treadplate_normal"
		$mraotexture			"pbr/metal/metal_treadplate_mrao"
		
		$basetexturetransform	"center 0.5 0.5 scale 4 4 rotate 0 translate 0 0"
		
		$surfaceprop			"metalpanel"

	}
}