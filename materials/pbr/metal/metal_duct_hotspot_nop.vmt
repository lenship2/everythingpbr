patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/metal/metal_duct_hotspot_color"
		$bumpmap 				"pbr/metal/metal_duct_hotspot_parallax"
		$mraotexture			"pbr/metal/metal_duct_hotspot_mrao"
		%rectanglemap			"pbr/metal/metal_duct_hotspot"
		
		$hsv					"[1 1 1.1]"
		
		$surfaceprop			"metalvent"
	}
	replace
	{
		$envmaptint				"0.76"
		$envmaplightscale		"0.67"
		$mraoscale				"[0.8 1 1]"
	}
}