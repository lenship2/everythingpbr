patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/metal/black_tiles_floor_b_color"
		$bumpmap 				"pbr/metal/black_tiles_floor_b_normal"
		$mraotexture			"pbr/metal/black_tiles_floor_b_mrao"
		$detail 				"detail/detail_blackfloor"
		$detailmask				"pbr/metal/black_tiles_floor_b_mask"
		
		$detailtransform		"center 0 0 scale 16.8 16.8 rotate 0 translate 0 0"
		$reflectivity			"[0.7 0.7 0.7]"

		$detailblendfactor 		"0.6"
		$detailblendmode 		"7"
		
		$surfaceprop			"metalpanel"
	}
	replace
	{
		$envmaptint				"0.1"
		$envmaplightscale		"0.9"
		$mraoscale              "[0.75 1.1 1]"
	}
}