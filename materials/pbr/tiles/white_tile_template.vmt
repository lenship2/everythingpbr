patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$detail 				"pbr/tiles/white_tile_detail"
		
		$detailblendmode		"10"
		$detailblendfactor		"1"
		
		$surfaceprop			"concrete"

		$detailtransform		"center 0.5 0.5 scale 180 180 rotate 0 translate 0 0"
		$basetexturetransform	"center 0.5 0.5 scale 4 4 rotate 0 translate 0 0"
		
		$reflectivity 			"[0.8 0.8 0.8]" 
		$mraoscale				"[0 10 1]"
		
		"%noportal"				"0"
	}
}