patch
{
	include					"materials/dev/l2_default_pbr_4x4.vmt"
	insert
	{
		$detail 				"pbr/tiles/white_tile_detail"
		
		$detailblendmode		"10"
		$detailblendfactor		"1"
		
		$surfaceprop			"concrete"

		$detailtransform		"center 0 0 scale 180 180 rotate 0 translate 0 0"
		
		$reflectivity 			"[0.8 0.8 0.8]" 
	}
	replace
	{
		"%noportal"				"0"
		$mraoscale				"[0 10 1]"
	}
}