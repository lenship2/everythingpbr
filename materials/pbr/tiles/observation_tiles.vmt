patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr\tiles\observation_tiles_Color"
		$bumpmap 				"pbr\tiles\observation_tiles_Normal"
		$mraotexture			"pbr\tiles\observation_tiles_MRAO"
		$detail					"detail\generic_detail_02"
		
		$detailblendmode		"0"
		$detailtransform		"center 0 0 scale 1 1 rotate 0 translate 0 0"
		$detailblendfactor		"0.4"
		
		$surfaceprop			"tile"
		
		$hsv					"[1 0.75 1.1]"
	}
}