PBR
{
	$basetexture 			"pbr/underground/wood/underground_plywood_clean_color"
	$bumpmap 				"pbr/underground/wood/underground_plywood_normal"
	$mraotexture			"pbr/underground/wood/underground_plywood_mrao"
	$detail					"vgui/white"
	$detailmask				"pbr/underground/wood/underground_plywood_detail"
	
	$detailblendmode		"1"
	$detailblendfactor		"1"
	
	$envmaptint				"0.5"
	
	$surfaceprop			"wood"
	$basetexturetransform	"center 0 0 scale 2 2 rotate 0 translate 0 0"
	$mraoscale              "[0.9 1 1]"
	$envmaplightscale		"0.5"

	$envmap					"env_cubemap"

	"%noportal"				"1"
	
	$srgbfactor				"2.2"
	$paintcolor				"[1 1 1]"

Proxies
{
	PaintOverlayColor
	{
		paintpower		"1"
		resultVar		$paintcolor
	}
	
	Expression
	{
		expression		"pow($paintcolor[0],$srgbfactor[0])"
		resultvar		"$detailtint[0]"
	}
	
	Expression
	{
		expression		"pow($paintcolor[1],$srgbfactor[1])"
		resultvar		"$detailtint[1]"
	}
	
	Expression
	{
		expression		"pow($paintcolor[2],$srgbfactor[2])"
		resultvar		"$detailtint[2]"
	}
}
}