PBR
{
	$basetexture 			"pbr/underground/wood/underground_plywood_clean_color"
	$bumpmap 				"pbr/underground/wood/underground_plywood_normal"
	$mraotexture			"pbr/underground/wood/underground_plywood_mrao"
	$detail					"dev/default_mrao"
	$detailmask				"pbr/underground/wood/underground_plywood_detail"
	
	$detailblendmode		"1"
	$detailblendfactor		"1"
	
	$envmaptint				"[0.05 0.05 0.05]"
	
	$surfaceprop			"wood"
	$basetexturetransform	"center 0 0 scale 2 2 rotate 0 translate 0 0"
	$mraoscale              "[0.9 1 1]"
	$envmaplightscale		"0.5"

	$parallax 				"0"
	$parallaxdither        	"0"
	$parallaxscale          "2"
	
	$blendtintbymraoalpha	"1"

	$envmap					"env_cubemap"

	"%noportal"				"1"
	
	$one					"[1 1 1]"
	$zero					"[0 0 0]"
	$nine					"0.95"

	Proxies
	{
		PaintOverlayColor
		{
			paintpower		"3"
			resultVar 		"$detailtint"
		}
		
		//srgb to linear approximation
		
		Multiply
		{
			srcVar1		$detailtint
			srcVar2		$detailtint
			resultVar	$detailtint
		}
		
		Multiply
		{
			srcVar1		$detailtint
			srcVar2		$nine
			resultVar	$detailtint
		}
		
		Clamp
		{
			max			$one
			min			$zero
			srcVar1		$detailtint
			resultVar	$detailtint
		}
		
	}
}