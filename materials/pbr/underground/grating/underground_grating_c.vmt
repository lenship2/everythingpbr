patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/underground/grating/underground_grating_color"
		$bumpmap 				"pbr/underground/grating/underground_grating_parallax"
		$mraotexture			"pbr/underground/grating/underground_grating_mrao"
		
		$surfaceprop			"metalgrate"
		
		$basetexturetransform	"center 0 0 scale 4 4 rotate 0 translate 0 0"
		
		$srgbtint				"{156 138 115}"
		$mraoscale              "[0.5 1.1 1]"
		
		$alphatest				"1"
		$AlphaTestReference 	"0.55"
		$allowalphatocoverage	"1"
		
		$parallax				"1"
		$parallaxcenter			"0.001"
		$parallaxdepth			"0.02"
		
		"%compilepassbullets"	"1"
		"%nopaint"				"1"
	}
}