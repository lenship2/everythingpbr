patch
{
	include					"materials/pbr/framework/squarebeams_base.vmt"
	insert
	{
		$basetexture 			"pbr/framework/squarebeam_crop/squarebeams_crop_02_color"
		$bumpmap 				"pbr/framework/squarebeam_crop/squarebeams_crop_02_Parallax"
		$mraotexture			"pbr/framework/squarebeam_crop/squarebeams_crop_02_mrao"
		
		$parallax 				"1"
		
		$hsv					"[1 1 0.45]"
	}
	replace
	{
		$mraoscale              "[0.5 1 1]"
	}
}