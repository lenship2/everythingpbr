patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/framework/squarebeam_crop/squarebeams_rust_crop_02_color"
		$bumpmap 				"pbr/framework/squarebeam_crop/squarebeams_rust_crop_02_parallax"
		$mraotexture			"pbr/framework/squarebeam_crop/squarebeams_rust_crop_02_mrao"
		
		$basetexturetransform	"center 0 0 scale 4 4 rotate 0 translate 0 0"
		
		$envmaptint				"[0.45 0.45 0.45]"
		
		$surfaceprop			"metal"
	}
}