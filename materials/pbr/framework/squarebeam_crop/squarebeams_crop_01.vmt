patch
{
	include					"materials/pbr/framework/squarebeams_base.vmt"
	insert
	{
		$basetexture 			"pbr/framework/squarebeam_crop/squarebeams_crop_01_color"
		$bumpmap 				"pbr/framework/squarebeam_crop/squarebeams_crop_01_Parallax"
		$mraotexture			"pbr/framework/squarebeam_crop/squarebeams_crop_01_mrao"

		$parallax 				"1"
	}
	replace
	{
		$mraoscale              "[0.5 1 1]"
	}
}