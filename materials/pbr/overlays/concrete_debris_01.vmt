patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/overlays/concrete_debris_01_color"
		$bumpmap 				"pbr/overlays/concrete_debris_01_normal"
		$mraotexture			"vgui/white"

		$basetexturetransform	"center 0 0 scale 1 1 rotate 0 translate 0 0"

		$mraoscale				"[0 1 1]"
		$hsv					"[1 1 0.9]"

		$decal					"1"
		$decalscale				"0.25"
		$translucent			"1"
	}
}