patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/overlays/tideline_color"
		$bumpmap 				"pbr/overlays/tideline_normal"
		$mraotexture			"vgui/white"

		$basetexturetransform	"center 0 0 scale 1 1 rotate 0 translate 0 0"
		
		$mraoscale				"[0 0.2 1]"	
		
		$decal					"1"
		$decalscale				"0.0625"
		$translucent			"1"
	}
}