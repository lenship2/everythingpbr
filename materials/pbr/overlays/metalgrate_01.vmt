patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/overlays/metalgrate_01_basecolor"
		$bumpmap 				"pbr/overlays/metalgrate_01_Parallax"
		$mraotexture			"pbr/overlays/metalgrate_01_mrao"
		
		$basetexturetransform	"center 0.5 0.5 scale 1 1 rotate 0 translate 0 0"
		
		$mraoscale              "[0.85 1 1]"
		$hsv					"[1 1 0.8]"
		
		$decalscale				"0.03125"
		$decal					"1"

		$alphatest				"1"

		$parallax 				"1"
		$parallaxcenter 		"0.2"
		$parallaxdepth 			"0.05"
		
		$surfaceprop			metalgrate
	}
}