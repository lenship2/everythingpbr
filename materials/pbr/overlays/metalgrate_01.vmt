patch
{
	include					"materials/dev/l2_default_overlay_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/overlays/metalgrate_01_basecolor"
		$bumpmap 				"pbr/overlays/metalgrate_01_Parallax"
		$mraotexture			"pbr/overlays/metalgrate_01_mrao"
		
		$hsv					"[1 1 0.8]"
		
		$decalscale				"0.03125"

		$alphatest				"1"

		$parallax 				"1"
		$parallaxcenter 		"0.2"
		$parallaxdepth 			"0.05"
		
		$surfaceprop			metalgrate
	}
	replace
	{
		$mraoscale              "[0.85 1 1]"
	}
}