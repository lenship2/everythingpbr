patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/overlays/metalgrate_02_basecolor"
		$bumpmap 				"pbr/overlays/metalgrate_02_Parallax"
		$mraotexture			"pbr/overlays/metalgrate_02_mrao"

		$basetexturetransform	"center 0 0 scale 1 1 rotate 0 translate 0 0"

		$decal					"1"
		$decalscale				"0.03125"

		$alphatest				"1"

		$parallax 				"1"
		$parallaxcenter 		"0.2"
		$parallaxdepth 			"0.045"
		
		$surfaceprop			metalgrate
	}
}