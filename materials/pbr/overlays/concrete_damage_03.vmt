patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/overlays/concrete_damage_01_color"
		$bumpmap 				"pbr/overlays/concrete_damage_03_Parallax"
		$mraotexture			"vgui/white"
		$detail					"pbr/overlays/concrete_damage_03_trans"
		
		$basetexturetransform	"center 0 0 scale 1 1 rotate 0 translate 0 0"
		
		$detailblendmode		"9"
		
		$mraoscale              "[0 0.6 1]"
		
		$decal					"1"

		$alphatest				"1"
		$allowalphatocoverage	"1"

		$parallax 				"1"
		$parallaxcenter 		"0.7"
		$parallaxdepth 			"0.03"
	}
}