patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/concrete/concrete_generic_01_color"
		$bumpmap 				"pbr/concrete/concrete_generic_01_normal"
		$mraotexture			"pbr/concrete/concrete_generic_01_mrao"
		
		$surfaceprop			"concrete"
		
		$hsv					"[1 0.9 0.8]"
		
		$basetexturetransform	"center 0 0 scale 4 4 rotate 0 translate 0 0"
	}
}