patch
{
	include					"materials/dev/l2_default_pbr.vmt"
	insert
	{
		$basetexture 			"pbr/concrete/concrete_wall_01_hotspot_color"
		$bumpmap 				"pbr/concrete/concrete_wall_01_hotspot_normal"
		$mraotexture			"pbr/concrete/concrete_wall_01_hotspot_mrao"
		$detail					"detail/generic_normal_detail_01"
		%rectanglemap			"dev/default_03"
		
		$detailblendmode		"10"
		
		$detailtransform		"center 0.5 0.5 scale 72 72 rotate 0 translate 0 0"
		$basetexturetransform	"center 0.5 0.5 scale 8 8 rotate 0 translate 0 0"
		
		$surfaceprop			"concrete"
	}
}