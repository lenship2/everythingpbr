PBR
{
	//make cubemaps and metal look okayish. envmaplightscale doesnt account for clustered but its okay because 
	//ambient lighting still affects it. maybe one day we can have better cubemap mipmapping
	$mraoscale              "[0.9 1 1]"
	$envmaptint				"0.5"
	$envmaplightscale		"0.5"
	
	$model					"1"

	//disable parallax usually, but when it is enabled turn off dithering and set to the highest quality.
	//pls don't do parallax on models unless u know what ur doing though
	$parallax 				"0"
	$parallaxdither        	"0"
	$parallaxscale          "2"

	//there's not really a situation where you would want this off (for now). 
	//the mrao maps have full alpha by default so enabling this doesnt change anything in most situations,
	//therefore it's nice to have it on by default for when you do need it...
	$blendtintbymraoalpha	"1"

	$envmap					"env_cubemap"
}