patch
{
	include					"materials/dev/l2_default_model_pbr.vmt"
	insert
	{
		$model					"0"
		
		//fixup for most higher-res basetextures
		$basetexturetransform	"center 0 0 scale 2 2 rotate 0 translate 0 0"
		$basetexturetransform2	"center 0 0 scale 2 2 rotate 0 translate 0 0"
		
		//most materials aren't portalable
		"%noportal"				"1"
		
		//setup envmap fixups for blend textures
		$mraoscale2				"[0.9 1 1]"
		$envmaptint2			"0.5"
	}
}