PBR
{
$basetexture 			"models\pbr\test_chambers\underground\wooden_box_Color"
$bumpmap 				"models\pbr\test_chambers\underground\wooden_box_Normal"
$mraotexture			"models\pbr\test_chambers\underground\wooden_box_MRAO"

$decaltexture			"models/pbr/paint_color"
$decalbump				"models/pbr/paint_normal"
$decalmrao				"vgui/white"

$decalmraointensity		"[0 0.15 1]"
$decalbumpintensity		"1"

$model					"1"

$mraoscale				"[0.9 1 1]"

$parallax 				"0"

$envmap					"env_cubemap"
$envmaptint				"[0.5 0.5 0.5]"
$envmaplightscale		"0.9"

$temp					"255"
$srgbfactor				"2.2"
$paintcolor				"[1 1 1]"

Proxies
{
	PaintOverlayColor
	{
		resultVar		$paintcolor
	}
	
	Expression
	{
		expression		"pow($paintcolor[0],$srgbfactor[0]) * $temp"
		resultvar		"$decaltint[0]"
	}
	
	Expression
	{
		expression		"pow($paintcolor[1],$srgbfactor[1]) * $temp"
		resultvar		"$decaltint[1]"
	}
	
	Expression
	{
		expression		"pow($paintcolor[2],$srgbfactor[2]) * $temp"
		resultvar		"$decaltint[2]"
	}
}
}