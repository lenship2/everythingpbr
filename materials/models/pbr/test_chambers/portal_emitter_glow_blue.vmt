unlitgeneric
{
	$basetexture	"models/pbr/test_chambers/portal_emitter_overlay"
	$additive		"1"
	
	$decal			"1"
	
	// Custom proxy variables
    $v_alternate 		"0"
	$v_sineconstant 	"1"
    $v_defaultColor 	"{0 60 255}"
    $v_zero 			"0"
    $v_defaultTint 		"[1 1 1]"
    $v_portalColor 		"{255 255 255}"
	$v_portaltype  		"{255 255 255}"
	
	Proxies
    {
        PortalColor
        {
            teamNumber		"0"
            portalNumber	"1"
            resultVar 		"$v_portalColor"
        }

        PortalAlternateColor
        {
            resultVar 		"$v_alternate"
        }

        LessOrEqual
        {
            srcVar1         "$v_alternate"        
            srcVar2         "$v_zero"             
            resultVar       "$v_portaltype"       
            LessEqualVar    "$v_defaultColor"     
            greaterVar      "$v_portalColor"      
        }
		
		Sine
		{
			sineperiod		"1.00"
			sinemin			"1"
			sinemax			"2"
			resultVar		"$v_sineconstant"
		}
		
		Multiply
		{
			srcVar1			"$v_portaltype"
			srcVar2			"$v_sineconstant"
			resultVar		"$color"
		}
    }
}