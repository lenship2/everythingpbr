PBR
{
$basetexture 			"models\pbr\test_chambers\cubes\cube_comp_Color"
$bumpmap 				"models\pbr\test_chambers\cubes\cube_painted_Normal"
$mraotexture			"models\pbr\test_chambers\cubes\cube_painted_MRAO"
$emissiontexture		"models\pbr\test_chambers\cubes\cube_painted_SelfIllum"

$detail					"vgui/white"
$detailmask				"models\pbr\test_chambers\cubes\cube_mask"

$detailblendmode		"2"
$detailblendfactor		"1"

$model					"1"
$blendtintbymraoalpha	"1"

$mraoscale				"[0.9 1 1]"
$emissionscale			"[0.708 0.491 0.063]"

$parallax 				"0"

$envmap					"env_cubemap"
$envmaptint				"[0.5 0.5 0.5]"
$envmaplightscale		"0.9"

$one					"[1 1 1]"
$zero					"[0 0 0]"
$nine					"0.95"

Proxies
{
	PaintOverlayColor
	{
		resultVar 				"$detailtint"
	}
	
	//srgb to linear approximation
	
	Multiply
	{
		srcVar1		$detailtint
		srcVar2		$detailtint
		resultVar	$detailtint
	}
	
	Multiply
	{
		srcVar1		$detailtint
		srcVar2		$nine
		resultVar	$detailtint
	}
	
	Clamp
	{
		max			$one
		min			$zero
		srcVar1		$detailtint
		resultVar	$detailtint
	}
	
}

}