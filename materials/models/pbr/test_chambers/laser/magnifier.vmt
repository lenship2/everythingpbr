vertexlitgeneric
{
$baseTexture "models/props/reflecto_cube_glass"
$bumpmap "models/props/reflecto_cube_glass_normal"
$translucent 1

//$srgbtint	"{30 34 38}"
//$alpha		"0.65"

$color2		"[5 5 5]"

$envmap env_cubemap
$normalmapalphaenvmapmask 1
$envmaptint "[ .1 .1 .1 ]"

$phong 1
$phongexponent 10
$phongboost 2
$phongfresnelranges "[0.95 0.1 0.3]"
$phongwarptexture "models/props/reflecto_cube_iridescence"
$nodecal 1
}
