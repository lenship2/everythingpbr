PBR
{
$basetexture 			"models\pbr\test_chambers\laser\schrodinger\schrodinger_Color"
$bumpmap				"models\pbr\test_chambers\laser\schrodinger\schrodinger_painted_Normal"
$mraotexture			"models\pbr\test_chambers\laser\schrodinger\schrodinger_painted_MRAO"
$detail					"vgui/white"
$detailmask				"models\pbr\test_chambers\laser\schrodinger\schrodinger_detail"

$detailblendmode		"2"
$detailblendfactor		"1"

$model					"1"
$blendtintbymraoalpha	"1"

$mraoscale              "[0.9 1 1]"

$parallax 				"0"

$envmaptint				"[0.5 0.5 0.5]"
$envmaplightscale		"0.6"
$envmap					"env_cubemap"

$one					"1"
$zero					"0"
$nine					"0.95"

Proxies
{
	PaintOverlayColor
	{
		"resultVar"		$detailtint
	}
	
	Multiply
	{
		srcVar1		$detailtint
		srcVar2		$detailtint
		resultVar	$detailtint
	}
	
	Multiply
	{
		srcVar1		$detailtint
		srcVar2		$nine
		resultVar	$detailtint
	}
	
	Clamp
	{
		max			$one
		min			$zero
		srcVar1		$detailtint
		resultVar	$detailtint
	}
}

}