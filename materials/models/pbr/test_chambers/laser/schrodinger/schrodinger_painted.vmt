PBR
{
$basetexture 			"models\pbr\test_chambers\laser\schrodinger\schrodinger_Color"
$bumpmap				"models\pbr\test_chambers\laser\schrodinger\schrodinger_painted_Normal"
$mraotexture			"models\pbr\test_chambers\laser\schrodinger\schrodinger_painted_MRAO"
$detail					"vgui/white"
$detailmask				"models\pbr\test_chambers\laser\schrodinger\schrodinger_detail"

$detailblendmode		"2"
$detailblendfactor		"1"

$model					"1"
$blendtintbymraoalpha	"1"

$mraoscale              "[0.9 1 1]"

$parallax 				"0"

$envmaptint				"[0.5 0.5 0.5]"
$envmaplightscale		"0.6"
$envmap					"env_cubemap"

$srgbfactor				"2.2"
$paintcolor				"[1 1 1]"

Proxies
{
	PaintOverlayColor
	{
		resultVar		$paintcolor
	}
	
	Expression
	{
		expression		"pow($paintcolor[0],$srgbfactor[0])"
		resultvar		"$detailtint[0]"
	}
	
	Expression
	{
		expression		"pow($paintcolor[1],$srgbfactor[1])"
		resultvar		"$detailtint[1]"
	}
	
	Expression
	{
		expression		"pow($paintcolor[2],$srgbfactor[2])"
		resultvar		"$detailtint[2]"
	}
}

}