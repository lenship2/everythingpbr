PBR
{
	$basetexture 			"models\pbr\elevator\elevator_shell_Color"
	$mraotexture			"models\pbr\elevator\elevator_shell_MRAO"
	$bumpmap				"models\pbr\elevator\elevator_shell_Normal"
	$emissiontexture		"models\pbr\elevator\elevator_shell_SelfIllum"
	
	$detailmask				"models\pbr\elevator\elevator_shell_detail"
	$detail					"vgui/white"
	
	$detailblendmode		"2"
	$detailblendfactor		"1"
	
	//$decaltexture			"models\pbr\stickersheet_01_color"
	//$decalbump				"models\pbr\stickersheet_01_normal"
	//$decalmrao				"models\pbr\stickersheet_01_mrao"

	$mraoscale				"[0.9 1 1]"
	$envmaptint				"0.5"
	
	$model					"1"

	$envmaplightscale		"0.5"

	$envmap					"env_cubemap"

	proxies
	{
		AnimatedTexture
		{
			animatedTextureVar			"$emissiontexture"
			animatedtextureframenumvar	"$emissionframe"
			animatedtextureframerate	"1.5"
		}
	}
}